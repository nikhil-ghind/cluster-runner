FROM rust:1.76-bookworm AS build
WORKDIR /src
COPY worker/ worker/
WORKDIR /src/worker
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/worker/target/release/ci-worker /usr/local/bin/ci-worker
# Worker needs CAP_SYS_ADMIN-style privileges to set up cgroups inside the
# pod. The kubelet grants those via the PodSecurityContext defined for
# this image; the binary itself drops capabilities once cgroup setup is done.
ENTRYPOINT ["/usr/local/bin/ci-worker"]
